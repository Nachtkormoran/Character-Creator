// Prisma schema für den Charakter Creator
// Docs: https://pris.ly/d/prisma-schema
//
// Aktuell SQLite (lokal, dateibasiert). Für ein späteres Deployment auf
// Vercel kann der Provider auf "postgresql" umgestellt werden – die Modelle
// bleiben nahezu unverändert.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Einfacher Key-Value-Speicher für App-Einstellungen (z. B. das gewählte
// Bildmodell). Bewusst generisch, damit weitere Einstellungen ohne Migration
// dazukommen können.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Szenario: eine Auswahl von Personen für eine Geschichte, zusammen mit
// Festlegungen, die für alle darin gelten (Ort, Zeit, Genre …).
//
// Bislang nur ein Name – der Behälter ist die eine Hälfte, die gemeinsamen
// Festlegungen kommen mit dem Ausbau dazu. Hieß früher `Group`; umbenannt,
// weil „Gruppe" nur das Bündeln ausdrückte und nicht, dass das Szenario
// selbst etwas festlegt.
model Scenario {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Der Name ist die Identität des Szenarios (und das Sortierkriterium),
  // deshalb eine echte Spalte.
  name       String

  // Alle übrigen Festlegungen (Genre, Ort, Zeit, Regeln …) als JSON-String,
  // wie `Character.traits` und `Character.input`. Hier kommen weitere Felder
  // dazu, und jedes einzelne wäre sonst eine eigene Migration.
  // Optional: Szenarien von vor diesem Feld haben keine Festlegungen.
  details    String?

  // Mehrere Handlungsentwürfe je Szenario als JSON `{ items, aktiv }` – die
  // **aktive** Variante steht zusätzlich als `details.handlung` (dort lesen sie
  // Export und Personensuche unverändert). Eigene Spalte statt in `details`,
  // wie `Character.storyHooks` neben `traits` liegt: eine Liste, die die
  // Oberfläche hält und die erst später auf Knopfdruck entsteht.
  // Optional – Altbestände haben nur die eine `details.handlung`.
  plotVariants String?

  // Der **Story Arc**: die dramaturgische Zerlegung des aktiven
  // Handlungsentwurfs (`details.handlung`) in eine geordnete Folge von Stationen
  // als JSON `{ stufen }`. Eigene Spalte statt in `details`, aus demselben
  // Grund wie `plotVariants`: eine Struktur, die die Oberfläche führt und die
  // erst auf Knopfdruck entsteht – kein Bestandteil der Festlegungen.
  // Optional – Altbestände und Szenarien ohne abgeleiteten Arc haben keinen.
  storyArc   String?

  // Mehrere Story Arcs je Szenario als JSON `{ items, aktiv }` – der **aktive**
  // Arc steht zusätzlich in `storyArc` (dort liest ihn der Export). Eigene
  // Spalte neben `storyArc`, genau wie `plotVariants` neben `details.handlung`:
  // eine Liste, die die Oberfläche führt und die erst auf Knopfdruck wächst.
  // Optional – Altbestände haben nur den einen `storyArc`.
  storyArcVariants String?

  // Beliebig viele Weltbilder je Szenario (Establishing-Shots des Ortes, ohne
  // Figuren); genau eines davon ist das Primärbild. Analog zu den
  // Charakter-Bildern (`CharacterImage`) in eine eigene Tabelle ausgelagert.
  // Vorher hielt das Szenario **ein** Bild direkt als Spalten `imageData` +
  // `thumbnail`; die sind mit der Mehrbild-Umstellung entfallen (die Migration
  // hat vorhandene Weltbilder als je ein Primärbild in `ScenarioImage` überführt).
  images     ScenarioImage[]

  characters Character[]
}

model Character {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String?

  // Optionale Zuordnung zu einem Szenario.
  // Wird das Szenario gelöscht, bleibt der Charakter erhalten (-> null).
  scenarioId  String?
  scenario    Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  // Ist die Figur ein Protagonist ihres Szenarios? Steuert den
  // Handlungsentwurf: sind welche markiert, dreht sich die Handlung um sie, die
  // übrigen sind Nebenfiguren. Ist niemand markiert, läuft alles wie bisher
  // (alle gleichrangig). Default false; nur innerhalb eines Szenarios sinnvoll.
  isProtagonist Boolean @default(false)

  // Ursprüngliche Formular-Eingaben als JSON-String
  input       String

  // Ein bis zwei Sätze als Zusammenfassung
  shortDescription String?

  // Ausführlicher Fließtext zum Charakter
  description String

  // Strukturierte Körper-/Charaktermerkmale als JSON-String
  // (SQLite kennt keinen nativen JSON-Typ, daher als String gespeichert)
  traits      String

  // Drei Ansatzpunkte für eine Geschichte, aus Beschreibung und Merkmalen
  // abgeleitet. Freitext (drei Absätze), nicht strukturiert: sie werden
  // gelesen und von Hand weitergeschrieben, nicht ausgewertet.
  // Optional – Altbestände haben keine, und erzeugt wird nur auf Knopfdruck.
  storyHooks  String?

  // Beliebig viele Bilder; genau eines davon ist das Primärbild.
  images      CharacterImage[]
}

// Ein einzelnes Bild eines Charakters (erzeugt oder hochgeladen).
//
// Ein Charakter kann mehrere Bilder haben; das mit `isPrimary` markierte wird
// überall groß angezeigt (Karte, Detailansicht, PDF). Dass es **genau eines**
// gibt, garantiert die Datenbank nicht – das stellt die API sicher (jedes
// Setzen läuft in einer Transaktion, die zuerst alle anderen zurücksetzt).
// Zur Sicherheit fällt die Auswahl beim Lesen auf das neueste Bild zurück.
model CharacterImage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  // Das Original als Data-URL (base64), ~2 MB.
  imageData   String

  // Verkleinerte Fassung (640 px, WebP) als Data-URL – nur für die Anzeige.
  // Optional, damit Bilder ohne Thumbnail weiter funktionieren.
  thumbnail   String?

  isPrimary   Boolean  @default(false)

  @@index([characterId])
}

// Ein einzelnes Weltbild eines Szenarios (erzeugt oder hochgeladen).
//
// Wortgleich zu `CharacterImage`, nur am Szenario: Ein Szenario kann mehrere
// Bilder haben; das mit `isPrimary` markierte wird überall groß angezeigt
// (Übersichtskarte, Detailseite, Export). Dass es **genau eines** gibt,
// garantiert die Datenbank nicht – das stellt die API sicher (jedes Setzen
// läuft in einer Transaktion, die zuerst alle anderen zurücksetzt). Zur
// Sicherheit fällt die Auswahl beim Lesen auf das neueste Bild zurück.
model ScenarioImage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  scenarioId  String
  scenario    Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  // Das Original als Data-URL (base64), ~2 MB.
  imageData   String

  // Verkleinerte Fassung (640 px, WebP) als Data-URL – nur für die Anzeige.
  // Optional, damit Bilder ohne Thumbnail weiter funktionieren.
  thumbnail   String?

  isPrimary   Boolean  @default(false)

  @@index([scenarioId])
}
